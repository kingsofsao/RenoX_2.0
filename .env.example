# Settings for docker-compose.yml. Copy to .env (git-ignored) next to docker-compose.yml.

# Your custom domain, without https:// (its DNS A/AAAA records must point at this server).
DOMAIN=research.example.com
# Let's Encrypt account e-mail (certificate expiry notices).
ACME_EMAIL=you@example.com

# Database password: generate one with `openssl rand -hex 32`.
FALKORDB_PASSWORD=

# Shown in the Privacy Policy, Terms and the contact form.
OPERATOR_NAME=Your name or company
CONTACT_EMAIL=privacy@example.com
