# Copy to backend/.env and fill in. backend/.env is git-ignored - never commit it.

# --- FalkorDB (required) -------------------------------------------------------
# From the FalkorDB Cloud console. Use falkors:// if your instance requires TLS.
FALKORDB_URL=falkor://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT
FALKORDB_GRAPH=researchmind

# --- API -----------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=10
# Where data lives (uploads/, documents/, processed/). Default: <repo>/data
# RESEARCHMIND_DATA_DIR=

# --- Embeddings ------------------------------------------------------------------
# auto = SentenceTransformers if it loads, otherwise an offline hashing embedder
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM (optional, next phase) -------------------------------------------------------
# Without a key, knowledge extraction uses the offline heuristic extractor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
USE_LLM_EXTRACTION=true
AGENT_EFFORT=high
CLAUDE_REFUSAL_FALLBACK=true

# --- Tests (optional) -------------------------------------------------------------
# Integration tests write only to throwaway graphs (researchmind_pytest*). E.g. a local Docker FalkorDB:
# FALKORDB_TEST_URL=falkor://localhost:6379
