# Copy to backend/.env and fill in. backend/.env is git-ignored - never commit it.

# --- FalkorDB (required) -------------------------------------------------------
# From the FalkorDB Cloud console. Use falkors:// if your instance requires TLS.
FALKORDB_URL=falkor://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT
FALKORDB_GRAPH=researchmind
# Store full page text as (:Page) nodes so papers can be read page by page in the FalkorDB browser
STORE_PAGES_IN_GRAPH=true

# --- Deployment and security ----------------------------------------------------
# production: Secure + __Host- cookies, HSTS, no /docs. Always set this when deploying.
ENVIRONMENT=development
# Force Secure cookies outside production too (only when the site is served over HTTPS).
# COOKIE_SECURE=false
# Absolute session lifetime and sign-out after inactivity
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
# Set to false to stop new sign-ups (existing users can still sign in)
ALLOW_SIGNUP=true
# true: investigations always use the AI model and fail clearly when it is unavailable,
# instead of falling back to the extractive offline report
AI_REQUIRED=true
# Concurrent investigations per account, and per-account hourly quotas
INVESTIGATIONS_PER_USER=1
INVESTIGATIONS_PER_HOUR=30
UPLOADS_PER_HOUR=60
# All API requests per client IP per minute; sign-in/sign-up attempts per IP per 15 minutes
RATE_LIMIT_PER_MINUTE=240
AUTH_ATTEMPTS_PER_WINDOW=20

# --- Public site: contact form, spam protection, site statistics ---------------------------
# Accounts (comma-separated e-mails) that may open Site statistics and read contact messages.
# Everyone else gets "not found" for those pages and endpoints.
ADMIN_EMAILS=
# Contact form messages accepted per IP per hour
CONTACT_PER_HOUR=5
# Sign-up and contact forms sent faster than this many seconds after loading are rejected as bots
FORM_MIN_SECONDS=3
# Key that signs the form challenges. Optional: a random key is generated at start-up (forms open
# during a restart then need resubmitting). Generate one with `openssl rand -hex 32`.
# SECRET_KEY=

# Behind Vercel (frontend/vercel.json): the shared secret Vercel adds to every proxied request. When set, requests
# without it get 404 and rate limits use Vercel's x-real-ip. Leave empty with docker-compose.yml.
# ORIGIN_SECRET=

# --- API -----------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly (CORS). In production use
# your HTTPS site origin, e.g. https://research.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=10
# Where data lives (uploads/, documents/, processed/). Default: <repo>/data
# RESEARCHMIND_DATA_DIR=

# --- Embeddings ------------------------------------------------------------------
# auto = SentenceTransformers if it loads, otherwise an offline hashing embedder. Images built with
# EMBEDDINGS=light (small hosts, e.g. Render free) have no SentenceTransformers: use hashing there.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Investigation LLM ---------------------------------------------------------------------
# ollama | anthropic | none. auto = anthropic if ANTHROPIC_API_KEY is set, else none.
# With AI_REQUIRED=true an AI provider must be configured, or investigations are refused.
LLM_PROVIDER=ollama
# Ollama model name (install first: ollama pull qwen3:8b). Larger models give better reports.
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# Per-request timeout; CPU-only machines need 600 or more
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONTEXT_TOKENS=8192
LLM_MAX_CONTEXT_CHARS=9000
LLM_MAX_TOOL_ROUNDS=2

# --- Anthropic (recommended for production) -----------------------------------------------
# Set LLM_PROVIDER=anthropic and the key below for the strongest reports and LLM extraction.
# The key stays on the server; the browser never sees it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_SECONDS=120
USE_LLM_EXTRACTION=true
AGENT_EFFORT=high
CLAUDE_REFUSAL_FALLBACK=true

# --- Investigation agent ------------------------------------------------------------------
# mcp = every tool call goes through the ResearchMind MCP server (in-process); direct = same tools, no protocol layer
AGENT_TOOL_TRANSPORT=mcp
# Max Claude tool-use rounds per investigation
AGENT_MAX_TURNS=14
# After this many seconds the agent stops calling tools and writes its report
INVESTIGATION_TIMEOUT_SECONDS=240
# Investigations allowed to run at once (extra requests get HTTP 429)
INVESTIGATION_MAX_CONCURRENT=2

# --- Embedding model download ---------------------------------------------------------------
# After the model has been downloaded once, skip HuggingFace network checks at startup:
# HF_HUB_OFFLINE=1

# --- Tests (optional) -------------------------------------------------------------
# Integration tests write only to throwaway graphs (researchmind_pytest*). E.g. a local Docker FalkorDB:
# FALKORDB_TEST_URL=falkor://localhost:6379
