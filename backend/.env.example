# Copy to backend/.env and fill in. backend/.env is git-ignored - never commit it.

# --- FalkorDB (required) -------------------------------------------------------
# From the FalkorDB Cloud console. Use falkors:// if your instance requires TLS.
FALKORDB_URL=falkor://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT
FALKORDB_GRAPH=researchmind
# Store full page text as (:Page) nodes so papers can be read page by page in the FalkorDB browser
STORE_PAGES_IN_GRAPH=true

# --- API -----------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=10
# Where data lives (uploads/, documents/, processed/). Default: <repo>/data
# RESEARCHMIND_DATA_DIR=

# --- Embeddings ------------------------------------------------------------------
# auto = SentenceTransformers if it loads, otherwise an offline hashing embedder
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Investigation LLM ---------------------------------------------------------------------
# ollama | anthropic | none. auto = anthropic if ANTHROPIC_API_KEY is set, else none (offline plan).
LLM_PROVIDER=auto
# Ollama model name, e.g. qwen2.5:1.5b (install first: ollama pull qwen2.5:1.5b)
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Per-request timeout; CPU-only machines need 600 or more
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONTEXT_TOKENS=8192
LLM_MAX_CONTEXT_CHARS=9000
LLM_MAX_TOOL_ROUNDS=2

# --- LLM (optional) ---------------------------------------------------------------------
# Without a key, extraction uses the heuristic extractor and investigations run the offline
# plan (same MCP tools, extractive cited report). The key stays on the server; React never sees it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_SECONDS=120
USE_LLM_EXTRACTION=true
AGENT_EFFORT=high
CLAUDE_REFUSAL_FALLBACK=true

# --- Investigation agent ------------------------------------------------------------------
# mcp = every tool call goes through the ResearchMind MCP server (in-process); direct = same tools, no protocol layer
AGENT_TOOL_TRANSPORT=mcp
# Max Claude tool-use rounds per investigation
AGENT_MAX_TURNS=14
# After this many seconds the agent stops calling tools and writes its report
INVESTIGATION_TIMEOUT_SECONDS=240
# Investigations allowed to run at once (extra requests get HTTP 429)
INVESTIGATION_MAX_CONCURRENT=2

# --- Embedding model download ---------------------------------------------------------------
# After the model has been downloaded once, skip HuggingFace network checks at startup:
# HF_HUB_OFFLINE=1

# --- Tests (optional) -------------------------------------------------------------
# Integration tests write only to throwaway graphs (researchmind_pytest*). E.g. a local Docker FalkorDB:
# FALKORDB_TEST_URL=falkor://localhost:6379
