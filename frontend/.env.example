# Optional. By default the dev server proxies /api to http://127.0.0.1:8000.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Set this only when the built app must call the API on another origin (then add that origin to ALLOWED_ORIGINS in backend/.env).
# VITE_API_BASE_URL=http://localhost:8000

# Public site settings, baked into the build (nothing secret: everything here is visible in the browser).
# With docker compose these come from the root .env (DOMAIN, OPERATOR_NAME, CONTACT_EMAIL) instead.
# The https:// address of the deployed site: canonical links, social previews, sitemap.xml and robots.txt.
# VITE_SITE_URL=https://research.example.com
# Who runs the service and where privacy requests go (shown in the Privacy Policy, Terms and contact form).
# VITE_OPERATOR_NAME=Your name or company
# VITE_CONTACT_EMAIL=privacy@example.com
