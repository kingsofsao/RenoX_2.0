# HTTPS for the custom domain. Caddy obtains and renews the Let's Encrypt certificate itself and
# redirects http:// to https://. Point the domain's DNS A/AAAA records at this server first.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy web:8080
}

# www. goes to the bare domain, so there is one canonical address.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
